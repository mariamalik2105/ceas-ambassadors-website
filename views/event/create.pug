//- UI for creating events
//- this UI is also used for editing events
//- @param event - the event to be edited
//- @param isEdit - true or false indicating edit
extends ../layout



block content
  //- if event wasn't defined, define it
  if !event
    - isEdit = false
    - event = {}
    - event.id = -1
    - event.title = ''
    - event.start_time = ''
    - event.end_time = ''
    - event.call_time = ''
    - event.location = ''
    - event.description = ''
    - event.public = true
    - event.meeting = false
    - event.sign_up_limit = 20
  if isEdit
    - isEdit = 'true'
  else
    - isEdit = 'false'
  -
    function getIsoDate(dateVal) {
      if (!dateVal || dateVal === '') return '';
      if (dateVal instanceof Date) return dateVal.toISOString();
      const parsed = Date.parse(dateVal);
      if (!isNaN(parsed)) return new Date(parsed).toISOString();
      return dateVal;
    }
  - startVal = getIsoDate(event.start_time)
  - endVal = getIsoDate(event.end_time)
  - callVal = getIsoDate(event.call_time)
  .container
    .box-border
      if isEdit === 'true'
        h1.create-title Edit Event
      else
        h1.create-title Create Event (Event 1)
      form.create-event(id='createEvent', action='/event/create', method='post')
        //- Hidden data for editing
        input(type='hidden', name='_csrf', value=csrfToken)
        input(type='hidden', name='isEdit', value=isEdit)
        input(type='hidden', name='eventId', value=event.id)
        .form-grid
          .left-grid
            div.form-group
              label Event Title:
              input.form-control.form-control-sm(type='text', name='title', value=event.title, placeholder='Tuesday Tour', tabindex=1)
            div.form-group
              label Start Time:
              input.form-control.form-control-sm(type='text', id='startTimeInput', name='startTime', value=startVal, placeholder='2018 January 01 10:00 AM', tabindex=3)
          .right-grid
            div.form-group
              label Location:
              input.form-control.form-control-sm(type='text', name='location', value=event.location, placeholder='653 Baldwin Hall', tabindex=2)
            div.form-group
              label End Time:
              input.form-control.form-control-sm(type='text', id='endTimeInput', name='endTime', value=endVal, placeholder='2018 January 01 11:00 AM', tabindex=4)
        div.form-group
          label Call Time:
          input.form-control.form-control-sm(type='text', id='callTimeInput', name='callTime', value=callVal, placeholder='2018 January 01 09:50 AM', tabindex=5, required)
        div.form-group
          label Description:
          input.form-control.form-control-sm(type='text', name='description', value=event.description, placeholder='This event...', tabindex=6)
        div.form-group
          label # of Allowed Sign-ups:
          input.form-control.form-control-sm(type='text', name='signUpLimit', value=event.sign_up_limit, placeholder='20', tabindex=5)
        div.form-group
          label Points:
          input.form-control.form-control-sm(type='number', step='any', name='points', value=event.points, placeholder='Points', tabindex=5.5)
        div.form-group.form-check
          input.form-check-input(type='checkbox', name='isPublic', checked=event.public, tabindex=6)
          label.form-check-label Public Event
        if isEdit === 'false'
          div.form-group.form-check
            input.form-check-input(type='checkbox', name='isMeeting', checked=event.meeting, tabindex=7)
            label.form-check-label Meeting
          div.form-group
            label Number of Duplicates (Additional Copies):
            input.form-control.form-control-sm(type='number', id='duplicateCountInput', name='duplicateCount', value='0', min='0', max='50', tabindex=8)
          div#duplicateFieldsContainer
        if isEdit === 'true'
          div.form-group.form-check
            input.form-check-input(type="checkbox", name='isDisabled', checked=event.is_disabled, tabindex=8)
            label.form-check-label(class="switch") Disable sign ups
        if isEdit === 'true'
          input.submit(type='submit', name='create', value='Edit Event', tabindex=9)
        else
          input.submit(type='submit', name='create', value='Create Event', tabindex=8)
      link(rel='stylesheet', href='/stylesheets/flatpickr.min.css')
      script(src='/javascripts/flatpickr.min.js')
      script(src='/javascripts/event-create.js')
